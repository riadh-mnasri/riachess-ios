{
  "expo": {
    "name": "RiaChess",
    "slug": "riachess-ios",
    "scheme": "riachess",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1226",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.riachess.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-localization",
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    },
    "owner": "riadhmnasri"
  }
}
